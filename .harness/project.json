{
  "schema_version": 2,
  "base_ref": "main",
  "max_attempts": 3,
  "parallel_max": 1,
  "check_timeout_seconds": 900,
  "review_max_age_seconds": 7200,
  "checks": {
    "capture-completeness": {
      "argv": [
        "env",
        "SCROLLSTITCH_CAPTURE_METRICS=1",
        "swift",
        "test",
        "--scratch-path",
        ".build/tests",
        "--cache-path",
        ".build/cache",
        "--disable-sandbox",
        "--filter",
        "VerticalCardCaptureTests"
      ],
      "tier": "critical",
      "budget": {
        "workload": {
          "frames": 83,
          "rows": 36,
          "output_pixels": 18885960
        },
        "inputs": [],
        "metrics": {
          "capture.refinement_windows": {
            "area": "loops",
            "unit": "windows",
            "max": 664
          },
          "capture.processing_seconds": {
            "area": "performance",
            "unit": "seconds",
            "max": 180
          }
        }
      }
    },
    "unit": {
      "argv": [
        "bash",
        "scripts/check.sh",
        "unit"
      ],
      "budget": {
        "workload": {"historical_owners": 1024, "future_alarms": 64, "reconciliations": 3},
        "inputs": [],
        "metrics": {
          "system.reads": {"area": "io", "unit": "calls", "min": 6, "max": 6},
          "recovery.write_bytes": {"area": "io", "unit": "bytes", "max": 4194302},
          "retry.schedules": {"area": "retry", "unit": "calls", "max": 0},
          "system.operations": {"area": "loops", "unit": "calls", "max": 71},
          "journal.peak_bytes": {"area": "data_size", "unit": "bytes", "max": 2097151},
          "journal.retained_owners": {"area": "data_size", "unit": "records", "max": 64}
        }
      }
    },
    "config": {
      "argv": [
        "bash",
        "scripts/check.sh",
        "config"
      ]
    },
    "alarm-data": {
      "argv": [
        "python3",
        "scripts/check_alarm_data.py"
      ]
    },
    "app-icon": {
      "argv": [
        "swift",
        "scripts/generate_icon.swift",
        "--check"
      ]
    },
    "device-build": {
      "argv": [
        "bash",
        "scripts/check.sh",
        "device-build"
      ]
    },
    "store-probe": {
      "argv": [
        "python3",
        "scripts/check_store_mode.py"
      ]
    },
    "store-archive": {
      "argv": [
        "bash",
        "scripts/check.sh",
        "store-archive"
      ]
    },
    "release-package": {
      "argv": [
        "python3",
        "scripts/check_release.py",
        "--mode",
        "local",
        "--app",
        ".build/StoreArchive.xcarchive/Products/Applications/ScrollStitchStore.app"
      ]
    },
    "public-tree": {
      "argv": [
        "python3",
        "scripts/check_public_tree.py"
      ]
    },
    "store-materials": {
      "argv": [
        "python3",
        "scripts/check_store_materials.py"
      ],
      "tier": "critical"
    }
  },
  "stage_checks": {
    "review": [
      "capture-completeness",
      "store-materials",
      "public-tree",
      "unit",
      "config",
      "alarm-data",
      "app-icon",
      "device-build",
      "store-probe",
      "store-archive",
      "release-package"
    ]
  },
  "adapters": {
    "push": {
      "argv": [
        "python3",
        "{plugin_root}/adapters/git_push.py",
        "--remote",
        "origin"
      ],
      "effect": "external",
      "timeout_seconds": 240
    }
  },
  "workflow": {
    "profile": "light",
    "target": "local",
    "isolation": "checkout",
    "assistance": "autonomous",
    "entry": "review",
    "integration_position": "before_push",
    "knowledge_approval": false,
    "stages": {
      "design_approval": false,
      "integration": false
    },
    "domain": "mixed",
    "capabilities": {
      "recon": "auto",
      "design": "auto",
      "design_audit": "auto",
      "review": "auto"
    }
  },
  "host": {
    "name": "codex",
    "available": [],
    "command": {
      "provider": "auto"
    },
    "worktree": "auto"
  }
}
